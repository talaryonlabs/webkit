@using Talaryon.WebKit.Models
@using Talaryon.WebKit.Services
@using Talaryon.WebKit.Services.Options
@implements IWebKitNavbar
@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject IWebKitConfigurator WebKitConfigurator


@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Dictionary<string, object>? InputAttributes { get; set; }
    
    private WebKitNavBarOptions? _navbarOptions;

    protected override void OnParametersSet()
    {
        _navbarOptions = WebKitConfigurator.Get<WebKitNavBarOptions>() ?? throw new WebKitOptionsNotConfigured<WebKitNavBarOptions>();
        Console.WriteLine("yolo");
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += (_, _) =>
        {
            StateHasChanged();
        };
    }
}

<div class="bg-secondary">
    <div class="container mx-auto">
        <div class="navbar text-primary-content">
            <div class="navbar-start gap-5">
                <a class="btn btn-xl btn-link pr-10" href="/">
                    <img src="@_navbarOptions?.LogoUrl" alt="Navigation Logo" class="w-64">
                </a>
                <div class="hidden lg:flex gap-5">
                    @if (_navbarOptions is { Links.Count: > 0 })
                    {
                        @foreach (var link in _navbarOptions.Links)
                        {
                            <a class="btn btn-primary btn-ghost" href="@link.Url" target="@link.Target">@link.Text</a>
                        }    
                    }
                </div>
            </div>
        </div>
    </div>
</div>