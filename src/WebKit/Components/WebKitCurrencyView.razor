@using System.Globalization
@using Talaryon.WebKit.Services
@using Talaryon.WebKit.Services.Options

@inject IWebKitConfig WebKitConfig

@rendermode InteractiveAuto

@code {
    [Parameter] public required float Value { get; set; }
    [Parameter] public string? Prefix { get; set; }
    [Parameter] public string? Postfix { get; set; }
    [Parameter] public bool IsCurrencyBefore { get; set; } = true;

    private string? _symbol;
    private CultureInfo? _cultureInfo;

    protected override void OnParametersSet()
    {
        var cultureInfo = WebKitConfig.Get<WebKitI18NOptions>().CultureInfo;

        _symbol = cultureInfo.NumberFormat.CurrencySymbol;
        _cultureInfo = (CultureInfo)cultureInfo.Clone();
        _cultureInfo.NumberFormat.CurrencyDecimalDigits = 0;
        //_cultureInfo.NumberFormat.CurrencyGroupSizes = [];
        _cultureInfo.NumberFormat.CurrencySymbol = "";
    }

    protected override void OnInitialized()
    {
        var cultureInfo = WebKitConfig.Get<WebKitI18NOptions>().CultureInfo;

        _symbol = cultureInfo.NumberFormat.CurrencySymbol;
        _cultureInfo = (CultureInfo)cultureInfo.Clone();
        _cultureInfo.NumberFormat.CurrencyDecimalDigits = 0;
        // _cultureInfo.NumberFormat.CurrencyGroupSizes = [];
        _cultureInfo.NumberFormat.CurrencySymbol = "";
    }

    private string Generate()
    {
        var items = new List<string>();

        if (Prefix is { Length: > 0 })
        {
            items.Add(Prefix);
        }

        if (IsCurrencyBefore && _symbol is { Length: > 0 })
        {
            items.Add(_symbol);
        }

        items.Add(Value.ToString("C", _cultureInfo));

        if (!IsCurrencyBefore && _symbol is { Length: > 0 })
        {
            items.Add(_symbol);
        }

        if (Postfix is { Length: > 0 })
        {
            items.Add(Postfix);
        }

        return string.Join(" ", items);
    }

}

<span>@Generate()</span>