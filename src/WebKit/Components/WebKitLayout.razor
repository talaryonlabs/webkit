@code {
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? InputAttributes { get; set; }
}

<div class="h-dvh flex flex-col transition-all text-base @InputAttributes?.GetValueOrDefault("webkit:class", "")" style="@InputAttributes?.GetValueOrDefault("webkit:style", "")">
    @if (Header is not null)
    {
        <div class="shrink">
            @Header
        </div>
    }

    @if (Content is null)
    {
        throw new WebKitException("No content provided. Please provide a <Content> child element.");
    }
    <main class="grow flex flex-col @InputAttributes?.GetValueOrDefault("webkit:body:class", "")" style="@InputAttributes?.GetValueOrDefault("webkit:body:style", "")">
        @Content
    </main>

    @if (Footer is not null)
    {
        <div class="shrink">
            @Footer
        </div>
    }
</div>