@page "/webkit/status-code/{code}"
@page "/webkit/status-code/{code}/{url}"

@code {
    [Parameter]
    public string? Code { get; set; }

    [Parameter]
    public string? Url { get; set; }
}

<WebKitMeta Title="@($"Error {Code}")" />

<WebKitContainer IsLoading="false">
    <WebKitStatusCode Code="@Code" Url="@Url" />
</WebKitContainer>