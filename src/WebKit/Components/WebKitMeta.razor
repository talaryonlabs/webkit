@using Microsoft.AspNetCore.Server.Kestrel.Core
@using Talaryon.WebKit.Services.Options
@inherits WebKitComponent
@rendermode InteractiveServer

@code {
    
    private WebKitMetaOptions? _metaOptions;
    private string? _title;
    private string? _description;
    private string? _image;

    protected override void OnComponentInitialized()
    {
        _metaOptions = WebKit.GetOptions<WebKitMetaOptions>();
    }

    protected override void OnPageChanged(WebKitPage page)
    {
        Console.WriteLine("Page changed to " + page.Title + "");
        _title = page is { Title.Length: > 0 } ? page.Title : null;
        _description = page is { Description.Length: > 0 } ? page.Description : null;
        _image = page is { Image.Length: > 0 } ? page.Image : null;
        
        InvokeAsync(StateHasChanged);
    }

}

<PageTitle>@(_title ?? _metaOptions.Title)</PageTitle>
<HeadContent>
    <title>@(_title ?? _metaOptions.Title)</title>

    <meta name="description" content="@(_description ?? _metaOptions.Description)"/>

    <meta property="og:type" content="website"/>
    <meta property="og:title" content="@(_title ?? _metaOptions.Title)"/>
    <meta property="og:description" content="@(_description ?? _metaOptions.Description)"/>
    <meta property="og:image" content="@(_image ?? _metaOptions.Image)"/>
    <meta property="og:site_name" content="@_metaOptions.ApplicationName"/>

    <meta name="twitter:card" content="summary_large_image">
    @*@if (WebKit.Default.TwitterAccount?.Length > 0)
    {
        <meta name="twitter:site" content="@WebKit.Default.TwitterAccount">
    }*@
    <meta name="twitter:title" content="@(_title ?? _metaOptions.Title)">
    <meta name="twitter:description" content="@(_description ?? _metaOptions.Description)">
    <meta name="twitter:image" content="@(_image ?? _metaOptions.Image)">
    <meta name="twitter:image:src" content="@(_image ?? _metaOptions.Image)">
</HeadContent>