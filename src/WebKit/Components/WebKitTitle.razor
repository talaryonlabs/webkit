@inherits WebKitComponent
@code {

    public enum TitleType
    {
        H1, H2, H3, H4, H5, H6
    }

    [Parameter] public TitleType Type { get; set; } = TitleType.H2;
}

@switch (Type)
{
    case TitleType.H1:
        <h1>@ChildContent</h1>
        break;
    case TitleType.H2:
        <h2>@ChildContent</h2>
        break;
    case TitleType.H3:
        <h3>@ChildContent</h3>
        break;
    case TitleType.H4:
        <h4>@ChildContent</h4>
        break;
    case TitleType.H5:
        <h5>@ChildContent</h5>
        break;
    case TitleType.H6:
        <h6>@ChildContent</h6>
        break;
}