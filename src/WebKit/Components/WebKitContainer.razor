@code {
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? InputAttributes { get; set; }

    private string _defaultContainerClass = "@container pt-5 pb-5 px-5 2xl:px-0";
    private string _defaultContentClass = "max-w-4xl 2xl:max-w-7xl mx-auto";

    private string _containerClasses = "";
    private string _contentClasses = "";

    private string GetItems(string items1, string items2)
    {
        var defaultItems = items1.Split(" ").ToList();
        var setItems = items2.Split(" ").ToList();
        var finalItems = new List<string>();

        foreach (var item in setItems)
        {
            var name = (item.Contains("-") ? item[..item.IndexOf("-", StringComparison.Ordinal)] : item).Trim();
            var index = defaultItems.FindIndex(v => v.StartsWith(name, StringComparison.Ordinal));
            if (index >= 0)
            {
                defaultItems.RemoveAt(index);
            }
            finalItems.Add(item);
        }
        finalItems.AddRange(defaultItems);
        
        return string.Join(" ", finalItems);
    }

    protected override void OnParametersSet()
    {
        _containerClasses = GetItems(_defaultContainerClass, (string)(InputAttributes?.GetValueOrDefault("webkit:class", "") ?? string.Empty));
        _contentClasses = GetItems(_defaultContentClass, (string)(InputAttributes?.GetValueOrDefault("webkit:content:class", "") ?? string.Empty));
    }

}
<div class="@_containerClasses" style="@InputAttributes?.GetValueOrDefault("webkit:style", "")">
    <div class="@_contentClasses" style="@InputAttributes?.GetValueOrDefault("webkit:content:style", "")">
        @ChildContent    
    </div>
</div>