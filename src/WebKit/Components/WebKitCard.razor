@code {
    [Parameter] public required string Title { get; set; }
    [Parameter] public required string ImageUrl { get; set; }
    [Parameter] public required RenderFragment ChildContent { get; set; }
    [Parameter] public string Size { get; set; } = "lg";


    private string GetCornerSize(string? position = "")
    {
        return position switch
        {
            "top" => $"rounded-t-{Size}",
            "bottom" => $"rounded-b-{Size}",
            "left" => $"rounded-l-{Size}",
            "right" => $"rounded-r-{Size}",
            _ => $"rounded-{Size}"
        };
    }

    private string GetShadowSize() => $"shadow-lg";
}

<div class="flex flex-col lg:flex-row @GetCornerSize() @GetShadowSize()">
    <figure class="basis-1/3">
        @* Visible on mobile *@
        <img class="lg:hidden @GetCornerSize("top") w-full h-full object-cover" src="@ImageUrl" alt="@Title"/>
        @* Visible on larger displays *@
        <img class="hidden lg:block @GetCornerSize("left") w-full h-full object-cover" src="@ImageUrl" alt="@Title"/>
    </figure>
    @* Visible on mobile *@
    <div class="lg:hidden basis-2/3 space-y-4 p-4 bg-secondary text-secondary-content @GetCornerSize("bottom")">
        <div class="text-xl">@Title</div>
        <div>
            @ChildContent
        </div>
    </div>
    @* Visible on larger displays *@
    <div class="hidden lg:block basis-2/3 space-y-4 p-4 bg-secondary text-secondary-content @GetCornerSize("right")">
        <div class="text-xl">@Title</div>
        <div>
            @ChildContent
        </div>
    </div>
</div>