@code {
    [Parameter] public required string Title { get; set; }
    [Parameter] public required string ImageUrl { get; set; }
    [Parameter] public required RenderFragment ChildContent { get; set; }
    [Parameter] public string Size { get; set; } = "lg";


    private string GetCornerSize(string? position = "")
    {
        return position switch
        {
            "top" => $"rounded-t-{Size}",
            "bottom" => $"rounded-b-{Size}",
            "left" => $"rounded-bl-{Size}",
            "right" => $"rounded-br-{Size}",
            _ => $"rounded-{Size}"
        };
    }

    private string GetShadowSize() => $"shadow-lg";
}

<span class="hidden rounded-t-lg rounded-b-lg rounded-bl-lg rounded-br-lg rounded-lg"></span>

<div class="flex flex-col @GetCornerSize() @GetShadowSize()">
    <div class="pt-4 bg-primary @GetCornerSize("top")"></div>
    <div class="flex flex-col lg:flex-row">
        <figure class="basis-1/3">
            @* Visible on mobile *@
            <img class="lg:hidden w-full h-full object-cover" src="@ImageUrl" alt="@Title"/>
            @* Visible on larger displays *@
            <img class="hidden lg:block w-full h-full object-cover @GetCornerSize("left")" src="@ImageUrl" alt="@Title"/>
        </figure>
        @* Visible on mobile *@
        <div class="lg:hidden basis-2/3 p-4 space-y-4 @GetCornerSize("bottom")">
            <div class="text-xl">@Title</div>
            <div>
                @ChildContent
            </div>
        </div>
        @* Visible on larger displays *@
        <div class="hidden lg:block basis-2/3 p-4 space-y-4 @GetCornerSize("right")">
            <div class="text-xl">@Title</div>
            <div>
                @ChildContent
            </div>
        </div>
    </div>
</div>


