@using Talaryon.WebKit.Services.Options

@using Talaryon.WebKit.Services
@inherits WebKitComponent
@inject IWebKitConfig WebKitConfig
@rendermode InteractiveServer

@code {
    private WebKitFooterOptions? _footerOptions;
    
    protected override void OnInitialized()
    {
        _footerOptions = WebKitConfig.Get<WebKitFooterOptions>();
    }

    protected virtual void OnConfigurationSet()
    {
        _footerOptions = WebKitConfig.Get<WebKitFooterOptions>();
    }
}

<footer class="footer footer-center p-10 bg-secondary text-secondary-content">
    <nav class="flex flex-wrap gap-4">
        @if (_footerOptions is not null)
        {
            @foreach (var item in _footerOptions.Links)
            {
                <a class="link link-hover" href="@item.Url" target="@item.Target">@item.Text</a>
            }
        }
    </nav>
    <nav class="md:place-self-center md:justify-self-center">
        <div class="grid grid-flow-col gap-4">
            @if (_footerOptions is not null)
            {
                @foreach (var item in _footerOptions.SocialIcons)
                {
                    <a href="@item.Url" target="@item.Target">
                        <img class="footer-social-icon rounded-lg" src="@item.Image" alt="@item.Text"/>
                    </a>
                }
            }
        </div>
    </nav>
    <aside>
        <p>Copyright © @DateTime.Now.Year @(_footerOptions is {CopyrightText.Length: >0 } ? $"- {_footerOptions.CopyrightText}" : "")</p>
    </aside>
</footer>
